<h2 class="ui header">Editar Filme</h2>
<form class="ui form" action="/filmes/{{filme.id}}?_method=PUT" method="POST">
  <div class="field">
    <label>Nome do Filme</label>
    <input type="text" name="nome" value="{{filme.nome}}">
  </div>
  <div class="field">
    <label>Ano</label>
    <input type="number" name="ano" value="{{filme.ano}}">
  </div>
  <button class="ui primary button" type="submit">Salvar</button>
</form>