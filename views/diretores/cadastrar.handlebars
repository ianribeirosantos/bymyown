<h2 class="ui header">Cadastrar Diretor</h2>
<form class="ui form" action="/diretores" method="POST">
  <div class="field"><label>Nome</label><input type="text" name="nome" required></div>
  <div class="field"><label>Data de nascimento</label><input type="date" name="anoNascimento" required></div>
  <div class="field"><label>Nacionalidade</label><input type="text" name="nacionalidade"></div>
  <button class="ui primary button" type="submit">Cadastrar</button>
  <a class="ui button" href="/diretores">Cancelar</a>
</form>