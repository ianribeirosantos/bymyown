<h2 class="ui header">Editar Diretor</h2>
<form class="ui form" action="/diretores/{{diretor.id}}?_method=PUT" method="POST">
  <div class="field"><label>Nome</label><input type="text" name="nome" value="{{diretor.nome}}" required></div>
  <div class="field"><label>Data de nascimento</label><input type="date" name="anoNascimento" value="{{diretor.anoNascimento}}" required></div>
  <div class="field"><label>Nacionalidade</label><input type="text" name="nacionalidade" value="{{diretor.nacionalidade}}"></div>
  <button class="ui primary button" type="submit">Salvar</button>
  <a class="ui button" href="/diretores/{{diretor.id}}">Cancelar</a>
</form>