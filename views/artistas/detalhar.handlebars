<div class="ui breadcrumb">
  <a class="section" href="/artistas">Artistas</a>
  <i class="right angle icon divider"></i>
  <div class="active section">{{artista.nome}}</div>
</div>

<div class="ui card" style="margin-top:1em">
  {{#if artista.foto}}
  <div class="image"><img src="{{artista.foto}}" alt="{{artista.nome}}"></div>
  {{/if}}
  <div class="content">
    <div class="header">{{artista.nome}}</div>
    <div class="meta">{{artista.nomeArtistico}}</div>
    <div class="description">Nascimento: {{artista.anoNascimento}}</div>
  </div>
  <div class="extra content">
    {{#if artista.emAtividade}}
      <span class="ui green label">Em atividade</span>
    {{else}}
      <span class="ui grey label">Inativo</span>
    {{/if}}
  </div>
</div>

<h3 class="ui header">Filmes</h3>

<div class="ui relaxed divided list">
  {{#each artista.filmes}}
  <div class="item">
    <i class="film icon"></i>
    <div class="content"><a class="header" href="/filmes/{{this.id}}">{{this.nome}}</a></div>
  </div>
  {{/each}}
</div>